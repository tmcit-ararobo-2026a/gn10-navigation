@startuml path_planner_flow
skinparam backgroundColor #FEFEFE
skinparam activityFontSize 12
skinparam noteFontSize 11

title path_planner_node 経路計画処理フロー

start

:目標ポーズ受信 (/goal_pose);
:最新コストマップ確認 (/costmap);

partition "TF自己位置取得 & 始点・終点決定" {
    :TFより現在ロボット位置を取得 (map -> base_link);
    :スタート・ゴールをグリッド座標に変換;
    if (障害物内 (cost >= 100)?) then (はい)
        :findNearestPassable() で最寄り通行可能セルへスナップ;
        note right
          * <b>a_star.snap_distance</b> (0.40 m)
        end note
        if (発見?) then (失敗)
            :空Path配信 & 終了;
            stop
        endif
    else (いいえ)
        :量子化誤差を防ぐため連続ワールド座標 (exact_start, exact_goal) を保持;
    endif
}

partition "8方向 A* グリッド探索" {
    :A* アルゴリズム実行;
    note right
      * <b>a_star.planning_cost</b> (0.5)
        cost = step_dist + costmap_val * planning_cost
    end note
    if (経路発見?) then (失敗)
        :空Path配信 & 終了;
        stop
    endif
}

partition "動的適応型 B-spline 平滑化" {
    :始点・終点を exact_start / approach_goal に置換;
    :stride (max_stride..1) と反復ラプラシアン平滑化を段階的に試行;
    note right
      * <b>bspline.max_stride</b> (10)
      * <b>bspline.smoothing_strength</b> (1.0)
      * <b>bspline.smoothing_iterations</b> (8)
      * <b>bspline.smooth_max_cost</b> (40)
      * <b>bspline.samples_per_segment</b> (10)
    end note
    :許容コスト以下で障害物に干渉しない最も滑らかな経路を採用;
    :低コスト領域かつ最小距離以上の区間を直線近似 (設定時のみ);
    note right
      * <b>line_approximation.max_cost</b> (-1: 無効)
      * <b>line_approximation.min_distance</b> (1.2 m)
    end note
    if (ゴールが障害物内にめり込んでいる?) then (スナップあり)
        :アプローチ中継点から本来の目標地点への\n直線進入アプローチ区間を末尾に付加;
    endif
}

partition "安全領域での旋回・姿勢計画" {
    :各点での全回転角度の最大フットプリントコストを算出;
    :長さ turn_distance の区間ウィンドウを走査し、\n区間全域が最も安全な旋回領域を選定;
    note right
      * <b>footprint.polygon</b> (8頂点外形)
      * <b>rotation_planning.turn_max_cost</b> (20)
      * <b>rotation_planning.angle_step</b> (0.15 rad)
      * <b>rotation_planning.turn_distance</b> (0.6 m)
    end note
    :Smoothstep (S字補間) で目標Yaw角を割り当て;
}

:nav_msgs/Path を配信 (/planned_path);

stop

@enduml
