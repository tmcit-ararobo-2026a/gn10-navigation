@startuml moving_bucket_launcher_flow
skinparam backgroundColor #FEFEFE
skinparam activity {
    StartColor #2E7D32
    EndColor #C62828
    BackgroundColor #ECEFF1
    BorderColor #37474F
    FontName "Noto Sans JP", sans-serif
}

title moving_bucket_launcher_node 処理フロー図

start

:バケツ上部開口部認識コールバック\n/bucket_opening_tracker/target (MovingBucketTrack)\n(または use_bottom_topic=true 時は bottom + bucket_height);

if (current_target_id == MovingBucket (7)\nかつ nav_cmd == Move (2) ?) then (Yes)
else (No: 固定ターゲット選択中 または Sleep/Stanby)
    :トピック干渉・不要出力回避のため処理スキップ;
    stop
endif

if (msg->valid == true ?) then (Yes)
else (No)
    :認識結果が無効のためスキップ;
    stop
endif

if ((now - last_observation_stamp) <= max_tracking_age_sec ?) then (Yes)
else (No: 鮮度タイムアウト)
    :古い計測値のためスキップ;
    stop
endif

:TF変換 (tf_buffer_->transform)\nframe_id -> base_link (point_robot);

if (TF取得成功 ?) then (Yes)
else (No: TF例外)
    :エラーログ出力しスキップ;
    stop
endif

:base_link 基準での距離・高低差算出\nL = hypot(point_robot.x, point_robot.y)\nΔx = L - launcher_offset_x\nΔz = (point_robot.z + aim_z_offset) - launcher_offset_z;

if (min_horizontal_dist <= L <= max_horizontal_dist\nかつ Δx > 0.05m ?) then (Yes)
else (No: 射程範囲外)
    :射程範囲外のためスキップ;
    stop
endif

:3次元弾道方程式による必要初速逆算\nv0 = sqrt( (g * Δx^2) / (2 * cos^2(θ) * (Δx * tan(θ) - Δz)) );

if (目標到達可能 (分母 > 0) ?) then (Yes)
else (No: 物理的到達不可)
    :到達不能警告出力しスキップ;
    stop
endif

:リリース速度変換 (shot-manager 軌道同定パラメータ)\nv_target = velocity_quad * v0^2 + velocity_scale * v0 + velocity_offset;

:機構許容範囲クランプ\nv_clamped = clamp(v_target, min_velocity, max_velocity);

:射出速度配信 (belt_launcher_speed_pub_)\n/robot/operation/belt_launcher_speed = v_clamped;

stop

@enduml
