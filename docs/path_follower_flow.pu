@startuml path_follower_flow
skinparam backgroundColor #FEFEFE
skinparam activityFontSize 12
skinparam noteFontSize 11

title path_follower_node 経路追従・制御ループ処理フロー

start

partition "経路受信・前処理 (onPlannedPath)" {
    :計画経路受信 (/planned_path);
    :等間隔リサンプリング & 単位接線ベクトル・曲率・空間角速度制限計算;
    note right
      * <b>path_interpolation_step</b> (0.02 m)
      * <b>curvature_window</b> (0.30 m)
      * <b>max_lateral_acceleration</b> (4.5 m/s^2)
      * <b>turn_yaw_rate_ratio</b> (0.75)
      * <b>min_turn_speed</b> (0.3 m/s)
    end note

    :S字速度プロファイル生成 & 前後方加減速走査;
    note right
      * <b>max_speed</b> (3.0 m/s)
      * <b>max_acceleration</b> (5.4 m/s^2)
      * <b>max_deceleration</b> (8.0 m/s^2)
      * <b>max_jerk</b> (60.0 m/s^3)
      * <b>decel_effective_ratio</b> (0.70)
    end note
}

partition "周期制御ループ (controlLoop: 50Hz)" {
    :TF取得 (map -> base_link) & 鮮度監視 (max_pose_age: 0.3s);
    if (TF異常またはタイムアウト?) then (異常)
        :非常停止 & FAIL遷移;
        stop
    endif

    if (MovingBucket 追従モード?) then (Tracking)
        :TF取得 (map -> bucket_bottom);
        if (TF成功?) then (Yes)
            :TFタイムアウトタイマー更新;
            :目標位置の指数平滑化 (EMA) LPF\n(tracking_pos_filter_alpha: 0.25);
        else (No: 一時ロスト)
            if (ロスト経過時間 <= tracking_timeout [1.0s]?) then (猶予内)
                :前回平滑化位置を保持し、追従継続;
            else (タイムアウト)
                :非常停止 & FAIL遷移;
                stop
            endif
        endif

        :ロボット現在位置から平滑化目標への目標Yaw角算出\nyaw_diff = normalizeAngle(target_yaw - current_yaw);

        if (|yaw_diff| < tracking_deadband [0.015 rad]?) then (不感帯内)
            :yaw_diff = 0.0 (チャタリング・モータ鳴き防止);
        endif

        :追従専用PID制御 (tracking_kp=3.5, ki=0, kd=0.0)\n+ D項1次LPF (tracking_d_filter_alpha: 0.2);
        :角速度・角加速度リミッタ (2.0 rad/s, 12.0 rad/s^2);
        :速度指令配信 (/robot/operation/cmd_vel\n並進速度=0, 角速度=omega);
        stop
    else (Moving 経路追従)
        :現在位置の直交射影 (proj_pt) と経路逸脱監視;
        if (横偏差 > max_path_error?) then (逸脱)
            :非常停止 & FAIL遷移;
            stop
        endif

        if (位置誤差 <= goal_tolerance [0.01m] &&\n角度誤差 <= goal_yaw_tolerance [0.0175rad] を\ngoal_settle_count 周期維持?) then (ゴール完了)
            :完全停止 & GOAL遷移;
            stop
        endif

        :遅延補償付き参照点 (ref_pt) の取得;
        note right
          * <b>control_comm_delay</b> (0.02 s)
          * <b>max_delay_compensation</b> (0.15 s)
        end note

        :接線FF速度 + 位置FB速度の合成 & 静止摩擦補償;
        note right
          * 巡航中: v_ff = ref_pt.speed * tangent
                    v_fb = PD(proj_pt - robot_pos) <= <b>max_cruise_fb_speed</b> (3.00 m/s)
          * ゴール近傍 (<b>settle_zone_distance</b> = 0.50 m 以内):
            ゴール座標への直接PID制御 (<b>position_kp = 6.0</b>) <= <b>max_fb_speed</b> (0.70 m/s) +
            最小起動速度リフト (<b>min_docking_speed</b> = 0.20 m/s)
        end note

        :1次の最大加速度リミッタ + 巡航発進時ロケットスタート;

        :姿勢(Yaw) PID制御 + 最小角速度リフト + 1次角加速度リミッタ;
        note right
          * <b>heading_kp / kd</b> (3.5 / 0.0, ki=0.0)
          * <b>min_docking_yaw_rate</b> (0.03 rad/s)
          * <b>max_angular_velocity / acceleration</b> (3.0 rad/s, 16.0 rad/s^2)
        end note

        :旋回ドリフト遅延補償 & ローカル座標変換;
        :速度指令配信 (/robot/operation/cmd_vel);
    endif
}

stop

@enduml
